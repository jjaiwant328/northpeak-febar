{
  "name": "northpeak-store-ops",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build:source": "npm run build:server && npm run build:client",
    "build": "echo 'Using prebuilt dist/ and client/dist artifacts'",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "db:generate": "drizzle-kit generate",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types"
  },
  "description": "NorthPeak Store Ops \u2014 stockout and markdown rescue",
  "license": "Unlicensed",
  "dependencies": {
    "@databricks/appkit": "0.57.0",
    "@databricks/appkit-ui": "0.57.0",
    "@databricks/sdk-experimental": "0.17.0",
    "@openai/agents": "^0.17.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.6.0",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.546.0",
    "mlflow-tracing": "^0.1.3",
    "next-themes": "0.4.6",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.9"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7"
  }
}